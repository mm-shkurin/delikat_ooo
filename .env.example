# Docker Compose from repo root: copy to .env (or use --env-file infra/.env).
# Same variables as infra/.env.example — keep in sync.

POSTGRES_USER=delikat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=delikat
POSTGRES_HOST_PORT=5434

BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
SITE_HOST_PORT=8767
GATEWAY_HOST_PORT=8080

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8767,http://localhost:8767,http://127.0.0.1:8080,http://localhost:8080

DATABASE_URL=postgresql+asyncpg://delikat:change-me@postgres:5432/delikat
# Host uvicorn: postgresql+asyncpg://delikat:change-me@127.0.0.1:5434/delikat
