DATABASE_URL=postgresql+asyncpg://delikat:change-me@127.0.0.1:5434/delikat
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8767,http://localhost:8767

# OAUTH_PROVIDER=fake — local sign-in without Yandex (see FakeOAuthProvider).
OAUTH_PROVIDER=fake
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
OAUTH_FRONTEND_CALLBACK_URL=http://127.0.0.1:5173/auth/callback
PUBLIC_BASE_URL=http://127.0.0.1:8000
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_COOKIE_MAX_AGE_SEC=2592000

# Required when OAUTH_PROVIDER=yandex. Placeholder JWT secrets are refused at startup.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/yandex/callback
