# Copy to infra/.env. Service hostnames in DATABASE_URL / REDIS_URL are compose names.

POSTGRES_USER=delikat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=delikat
POSTGRES_HOST_PORT=5434

REDIS_HOST_PORT=6380

BACKEND_HOST_PORT=8000
MOCK_API_HOST_PORT=8002
FRONTEND_HOST_PORT=5173
SITE_HOST_PORT=8767
GATEWAY_HOST_PORT=8080

DATABASE_URL=postgresql+asyncpg://delikat:change-me@postgres:5432/delikat
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8767,http://localhost:8767,http://127.0.0.1:8080,http://localhost:8080

# --- OAuth ---
# fake  = local sign-in without Yandex (default for Docker compose on :8000)
# yandex = real Yandex OAuth; set YANDEX_CLIENT_ID / YANDEX_CLIENT_SECRET
OAUTH_PROVIDER=fake
# Distinct secrets, ≥16 chars. Exact example placeholders "change-me-*-secret-change-me" are refused at startup.
JWT_ACCESS_SECRET=local-dev-access-secret-16c
JWT_REFRESH_SECRET=local-dev-refresh-secret-16c
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# After Yandex callback, browser lands here (Vite SPA).
OAUTH_FRONTEND_CALLBACK_URL=http://127.0.0.1:5173/auth/callback
# Public origin of the API as seen by the browser / Yandex redirect.
# Direct backend:  http://127.0.0.1:8000
# Via gateway:     http://127.0.0.1:8080  (GATEWAY_HOST_PORT) — then align YANDEX_REDIRECT_URI
PUBLIC_BASE_URL=http://127.0.0.1:8000
SESSION_COOKIE_MAX_AGE_SEC=2592000

# Required when OAUTH_PROVIDER=yandex. Redirect must match PUBLIC_BASE_URL host/port:
#   …:8000/api/v1/auth/oauth/yandex/callback  OR  …:8080/api/v1/auth/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/yandex/callback
