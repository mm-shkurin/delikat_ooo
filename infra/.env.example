# Copy → infra/.env  (gitignored). All values below are fake local demos.
# Service hostnames in DATABASE_URL / REDIS_URL are Docker Compose network names.

POSTGRES_USER=delikat
POSTGRES_PASSWORD=delikat_dev_password
POSTGRES_DB=delikat
POSTGRES_HOST_PORT=5434

REDIS_HOST_PORT=6380

BACKEND_HOST_PORT=8000
MOCK_API_HOST_PORT=8002
FRONTEND_HOST_PORT=5173
SITE_HOST_PORT=8767
GATEWAY_HOST_PORT=8080

DATABASE_URL=postgresql+asyncpg://delikat:delikat_dev_password@postgres:5432/delikat
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8767,http://localhost:8767,http://127.0.0.1:8080,http://localhost:8080

# --- Auth (local) ---
# fake = no Yandex (default). yandex = set real client id/secret in your private .env only.
OAUTH_PROVIDER=fake
JWT_ACCESS_SECRET=delikat-dev-access-secret
JWT_REFRESH_SECRET=delikat-dev-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OAUTH_FRONTEND_CALLBACK_URL=http://127.0.0.1:5173/auth/callback
PUBLIC_BASE_URL=http://127.0.0.1:8000
SESSION_COOKIE_MAX_AGE_SEC=2592000

# Shape only — unused while OAUTH_PROVIDER=fake. Put real values only in private .env.
YANDEX_CLIENT_ID=yandex-client-id-fake
YANDEX_CLIENT_SECRET=yandex-client-secret-fake
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/yandex/callback
